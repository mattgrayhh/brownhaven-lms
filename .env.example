# ============================================================================
# Frappe Learning LMS - Environment Variables Template for Railway Deployment
# ============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file with sensitive data to version control
# ============================================================================

# ============================================================================
# REQUIRED - Database Configuration
# ============================================================================

# MariaDB root password - Set a strong password for the database root user
MARIADB_ROOT_PASSWORD=your_root_password

# Database name for the LMS application
MARIADB_DATABASE=lms

# Database user for Frappe/ERPNext application
MARIADB_USER=frappe

# Password for the database user - Set a strong password
MARIADB_PASSWORD=your_db_password

# Database host - Use service name from docker-compose or Railway internal URL
DB_HOST=db

# Database port - Default MariaDB port
DB_PORT=3306

# ============================================================================
# REQUIRED - Redis Configuration
# ============================================================================

# Redis connection URL - Used for caching, queuing, and session management
# Format: redis://[host]:[port]
REDIS_URL=redis://redis:6379

# ============================================================================
# REQUIRED - Site Configuration
# ============================================================================

# Site name - The domain/subdomain where LMS will be accessible
# For Railway deployment, use your Railway domain or custom domain
SITE_NAME=lms.localhost

# Administrator password - Set a strong password for the admin user
ADMIN_PASSWORD=your_admin_password

# Developer mode - Set to 1 for development, 0 for production
# Production should always be 0 for better performance
FRAPPE_DEVELOPER_MODE=0

# ============================================================================
# OPTIONAL - Payment Gateway Configuration
# ============================================================================

# Payment gateway provider - Currently supports Razorpay
PAYMENT_GATEWAY=Razorpay

# Default currency for payments and pricing
DEFAULT_CURRENCY=USD

# Razorpay API Key ID - Get from Razorpay dashboard
RAZORPAY_KEY_ID=

# Razorpay API Key Secret - Get from Razorpay dashboard (keep secure)
RAZORPAY_KEY_SECRET=

# Apply GST on payments - Set to 1 to enable, 0 to disable
APPLY_GST=0

# ============================================================================
# OPTIONAL - External Services
# ============================================================================

# Unsplash Access Key - For integrating Unsplash images in course content
# Get from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# LiveCode URL - For code execution environment in coding courses
# Default Frappe LiveCode server or use your own instance
LIVECODE_URL=https://falcon.frappe.io/

# ============================================================================
# OPTIONAL - Mail Server Configuration
# ============================================================================

# SMTP server hostname for sending emails (notifications, password resets, etc.)
MAIL_SERVER=

# SMTP server port - Common ports: 587 (TLS), 465 (SSL), 25 (unencrypted)
MAIL_PORT=587

# Email account username/login for SMTP authentication
MAIL_LOGIN=

# Email account password for SMTP authentication
MAIL_PASSWORD=

# Use TLS encryption - Set to 1 to enable, 0 to disable
# Recommended: 1 for security
MAIL_USE_TLS=1

# ============================================================================
# OPTIONAL - Production Performance Configuration
# ============================================================================

# Number of background workers for processing jobs (queue, scheduler, etc.)
# Adjust based on your Railway plan resources
WORKERS=2

# Number of Gunicorn workers for handling web requests
# Formula: (2 x CPU cores) + 1, adjust based on Railway resources
GUNICORN_WORKERS=4

# ============================================================================
# Additional Notes
# ============================================================================
#
# Railway Deployment Tips:
# 1. Set all REQUIRED variables before first deployment
# 2. Use Railway's internal DNS for service communication (db, redis)
# 3. Update SITE_NAME with your Railway-provided domain or custom domain
# 4. Keep passwords and API keys secure - use Railway's environment variables
# 5. For production: Set FRAPPE_DEVELOPER_MODE=0
# 6. Configure mail server for user notifications and password resets
# 7. Scale WORKERS and GUNICORN_WORKERS based on your Railway plan
#
# For more information:
# - Frappe LMS Documentation: https://github.com/frappe/lms
# - Railway Documentation: https://docs.railway.app/
#
# ============================================================================
